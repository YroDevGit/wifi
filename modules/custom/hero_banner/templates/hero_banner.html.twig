<!-- Hero Section with Image Banner (working image) -->
<section class="hero-section text-white py-5 overflow-hidden">
	<div class="container py-lg-5 my-3">
		<div class="row align-items-center g-5">
			<div class="col-lg-6 order-lg-1 order-2">
				{% if gb and promo_check %}
        <span class="badge bg-warning text-dark mb-3 px-3 py-2 rounded-pill">
					<i class="bi bi-speedometer2"></i>{{gb}}</span>
        {% endif %}

				<h1 class="display-4 fw-bold mb-3">{{title}}</h1>
				<p class="lead mb-4 opacity-90">{{description}}</p>
				<div class="d-flex flex-wrap gap-3">
					<a href="{{explore_url.url ?? '/'}}" class="btn btn-light btn-lg rounded-pill px-5 py-3 fw-semibold text-primary">Explore Plans
						<i class="bi bi-arrow-right-short"></i>
					</a>
					<a href="{{install_url.url ?? '/'}}" class="btn btn-outline-light btn-lg rounded-pill px-5 py-3" data-bs-toggle="modal" data-bs-target="#signupModal">Get Installation</a>
				</div>
				<div class="mt-4 d-flex gap-4 small">
        {% if promo_check %}
          {% for item in promos %}
            <div>
						<i class="bi bi-check-circle-fill me-1"></i>
						{{item.name}}</div>
          {% endfor %}
        {% endif %}
				</div>
			</div>
			<div
				class="col-lg-6 order-lg-2 order-1 text-center">
				<!-- Working sample image: modern WiFi router setup -->
				<img src="{{img.image_url ?? 'https://images.unsplash.com/photo-1563013544-824ae1b704d3?w=600&h=450&fit=crop'}}" alt="Modern WiFi Router and Smart Home Devices" class="img-fluid wifi-illustration rounded-4 shadow-lg hero-img" style="max-width: 100%; height: auto; object-fit: cover; min-height: 300px;">
			</div>
		</div>
	</div>
</section>
