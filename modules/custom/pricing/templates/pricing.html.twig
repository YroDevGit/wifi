<!-- PLANS / PRICING SECTION (Cards) -->
<section id="plans" class="py-5">
	<div class="container py-4">
		<div class="text-center mb-5">
			<span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill">Internet Plans</span>
			<h2 class="display-5 fw-bold mt-2">Choose Your Perfect Speed</h2>
			<p class="lead text-secondary w-75 mx-auto">Fiber-powered plans with symmetrical upload & download, no
																          contracts.</p>
		</div>
		<div
			class="row g-4 justify-content-center">
			<!-- Plan 1 -->
			{% for item in pac %}
				<div class="col-lg-4 col-md-6">
					<div class="card h-100 border-0 shadow-card price-card p-4">
          {% if item.field_popular %}
          <div class="popular-badge">🔥 MOST POPULAR</div>
          {% endif %}
						<h3 class="fw-bold">{{item.name}}</h3>
						<div class="mt-2 mb-3">
							<span class="display-4 fw-bold">${{item.field_price}}</span>
							<span class="text-secondary">/mo</span>
						</div>
						<hr>
						<ul class="list-unstyled mt-3 mb-4">
            {% if item.field_items %}
              {% for i in item.field_items %}
                {% set var = i | split("\n") %}
                {% set icon = var[0] ?? "" %}
                {% set text = var[1] ?? "" %}
              <li class="mb-2"><i class="{{icon}}"></i> {{text}}</li>
              {% endfor %}
            {% endif %}
            </ul>
						<div class="mt-auto">
							{% if item.field_url %}
              <a href="{{item.field_url.url}}" class="btn btn-outline-primary rounded-pill w-100 py-2" data-bs-toggle="modal" data-bs-target="#signupModal">{{item.field_url.title}}</a>
              {% endif %}
						</div>
					</div>
				</div>
			{% endfor %}

		</div>
	</div>
</section>
